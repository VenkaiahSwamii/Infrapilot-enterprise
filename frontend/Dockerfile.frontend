FROM node:22-alpine AS builder
WORKDIR /app
COPY . .
RUN if [ -f "package.json" ]; then npm ci && npm run build && cp -r dist /app-dist; else cd frontend && npm ci && npm run build && cp -r dist /app-dist; fi

FROM nginx:alpine
COPY --from=builder /app-dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
